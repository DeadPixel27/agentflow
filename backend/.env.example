# Copy this file to .env and fill in your keys
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- LLM (free tier: Groq only) ---
# Get at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# --- LLM (optional: OpenAI planner — NOT free, ~$5 minimum) ---
# Get at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your_key_here

# --- Supabase (optional — falls back to in-memory if not set) ---
# Setup guide: backend/SUPABASE_SETUP.md
# 1. Create project at https://supabase.com
# 2. Run supabase/schema.sql in SQL Editor
# 3. Settings → API → Project URL + Secret key (sb_secret_...)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# --- Data persistence (users, workflows, runs) ---
# auto   = Supabase Postgres when SUPABASE_* is set, else in-memory
# memory = always in-memory (lost on restart)
# supabase = always Supabase Postgres
PERSISTENCE_BACKEND=auto

# --- Auth ---
# email = sign in / register by email lookup (no password)
# supabase = future Supabase Auth provider
AUTH_BACKEND=email

# auto     = Supabase Storage when SUPABASE_* is set, else local disk (default)
# local    = always save to UPLOAD_DIR (backend/uploads/)
# supabase = always use Supabase Storage bucket below
DOCUMENT_STORAGE=auto
SUPABASE_DOCUMENTS_BUCKET=documents
