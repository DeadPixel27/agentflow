# Copy this file to .env and fill in your keys
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- LLM (free tier: Groq only) ---
# Get at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
# Primary model for extraction/planning (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_REFINER_MODEL=llama-3.3-70b-versatile
# GROQ_OWNER_MODEL=llama-3.3-70b-versatile
# Fallback models tried in order when primary fails (API errors, bad JSON, etc.)
# GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,meta-llama/llama-4-scout-17b-16e-instruct,openai/gpt-oss-20b

# --- LLM (optional: OpenAI planner — NOT free, ~$5 minimum) ---
# Get at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your_key_here

# --- Supabase (optional — falls back to in-memory if not set) ---
# Setup guide: backend/SUPABASE_SETUP.md
# 1. Create project at https://supabase.com
# 2. Run supabase/schema.sql in SQL Editor
# 3. Settings → API → Project URL + Secret key (sb_secret_...)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# --- Data persistence (users, workflows, runs) ---
# auto   = Supabase Postgres when SUPABASE_* is set, else in-memory
# memory = always in-memory (lost on restart)
# supabase = always Supabase Postgres
PERSISTENCE_BACKEND=auto

# --- Auth ---
# email = sign in / register by email lookup (no password)
# supabase = future Supabase Auth provider
AUTH_BACKEND=email

# --- CORS (comma-separated frontend origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Rate limits (slowapi format) ---
RATE_LIMIT_RUNS_ADHOC=10/minute
RATE_LIMIT_UPLOAD=20/minute

# auto     = Supabase Storage when SUPABASE_* is set, else local disk (default)
# local    = always save to UPLOAD_DIR (backend/uploads/)
# supabase = always use Supabase Storage bucket below
DOCUMENT_STORAGE=auto
SUPABASE_DOCUMENTS_BUCKET=documents

# --- User template version payloads (refined templates) ---
# auto     = Supabase Storage when SUPABASE_* is set, else local disk
# local    = backend/uploads/user-templates/
# supabase = Supabase Storage bucket below
# aws_s3   = future AWS S3 swap (set AWS_S3_BUCKET)
USER_TEMPLATE_STORAGE=auto
SUPABASE_USER_TEMPLATES_BUCKET=user-templates
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# ADMIN_API_KEY=

# --- Email delivery (Resend — free tier 3000/month) ---
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Google Sheets (service account) ---
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- Inbound email (Mailgun webhook) ---
# INBOUND_EMAIL_DOMAIN=ingest.agentflow.app
# INBOUND_WEBHOOK_SECRET=your_mailgun_signing_key
