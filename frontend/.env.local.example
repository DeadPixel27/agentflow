NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=10
NEXT_PUBLIC_MAX_PAGES_PER_FILE=10
# Google Identity Services — same OAuth Web client ID as backend GOOGLE_CLIENT_ID
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# Email name form (local/tests only). Must match backend AUTH_ALLOW_EMAIL.
# NEXT_PUBLIC_AUTH_ALLOW_EMAIL=true
